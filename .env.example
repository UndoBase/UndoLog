# ═══════════════════════════════════════════════════════════════════════════════
# UndoLog Configuration Template (.env.example)
#
# Copy this file to .env and configure for your environment:
#   cp .env.example .env
#   # Edit .env with your actual values
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string for the engine.
# Format: postgresql://[user[:password]@][host][:port][/database][?params]
# Default (engine): postgresql://postgres:postgres@localhost:5432/undolog_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/undolog

# Test database URL (for E2E and integration tests).
# Must differ from DATABASE_URL to avoid corrupting your dev database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/undolog_test

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────

# Valid values: trace, debug, info, warn, error
UNDOLOG_LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────────
# ENGINE CONFIGURATION (Rust binary)
# ─────────────────────────────────────────────────────────────────────────────

# gRPC and health listen addresses
UNDOLOG_ENGINE_GRPC_ADDR=0.0.0.0:50051
UNDOLOG_ENGINE_HEALTH_ADDR=0.0.0.0:9090

# How often (seconds) to refresh the tool tier registry from the database
UNDOLOG_REGISTRY_REFRESH_SECS=60

# Advisory lock retry settings (attempts x backoff_ms)
UNDOLOG_LOCK_MAX_ATTEMPTS=3
UNDOLOG_LOCK_RETRY_MS=100

# Approval lifecycle. Defaults: 86400 seconds, false, 60 seconds.
UNDOLOG_APPROVAL_TIMEOUT_SECS=86400
UNDOLOG_AUTO_APPROVE_ON_TIMEOUT=false
UNDOLOG_TIMEOUT_CHECK_INTERVAL_SECS=60

# Shared secret presented on every engine gRPC call.
# Default: empty (authentication off)
UNDOLOG_ENGINE_AUTH_TOKEN=

# Database file of the undolog-engine-sqlite binary. Default: undolog.db
UNDOLOG_SQLITE_PATH=undolog.db

# OpenTelemetry export for the engine. Default: empty (no export)
UNDOLOG_OTEL_ENDPOINT=
# Engine log filter, which overrides UNDOLOG_LOG_LEVEL when set.
# Default: info; this matches the debug level configured above.
UNDOLOG_OTEL_LOG_LEVEL=debug
# Service name attached to exported spans. Default: undolog-engine
UNDOLOG_OTEL_SERVICE_NAME=undolog-engine

# ─────────────────────────────────────────────────────────────────────────────
# PROXY CONFIGURATION (Go binary)
# ─────────────────────────────────────────────────────────────────────────────

# HTTP listen address
UNDOLOG_PROXY_LISTEN_ADDR=:8080

# gRPC address of the Rust engine
UNDOLOG_PROXY_ENGINE_GRPC_ADDR=localhost:50051

# Upstream tool endpoint that receives forwarded tool executions.
# Required for approve/reject flows that execute the tool inline.
# Default: empty (no upstream tool forwarding)
UNDOLOG_PROXY_UPSTREAM_TOOL_URL=http://localhost:9091/tools

# API keys for proxy authentication (format: key1=org_id1,key2=org_id2)
UNDOLOG_PROXY_API_KEYS=dev-key=org_dev

# HTTP server timeouts (seconds)
UNDOLOG_PROXY_READ_TIMEOUT_SECS=15
UNDOLOG_PROXY_WRITE_TIMEOUT_SECS=15
UNDOLOG_PROXY_SHUTDOWN_TIMEOUT_SECS=30
UNDOLOG_PROXY_REQUEST_TIMEOUT_SECS=30

# Dashboard SSE event buffer size (per-org channel capacity)
UNDOLOG_PROXY_DASHBOARD_EVENT_CHAN_SIZE=128

# Optional TOML configuration file; environment values win over it.
# Default: empty (environment and defaults only)
UNDOLOG_PROXY_CONFIG=

# Shared secret presented to the engine on gRPC calls. Default: empty
UNDOLOG_PROXY_ENGINE_AUTH_TOKEN=

# Engine retry budget: attempts and base backoff in milliseconds.
# Defaults: 3, 100
UNDOLOG_PROXY_ENGINE_RETRY_MAX_ATTEMPTS=3
UNDOLOG_PROXY_ENGINE_RETRY_BASE_MS=100

# Request header read and keep-alive idle timeouts in seconds.
# Defaults: 15, 60
UNDOLOG_PROXY_READ_HEADER_TIMEOUT_SECS=15
UNDOLOG_PROXY_IDLE_TIMEOUT_SECS=60

# Request size limits in bytes. Defaults: 1048576, 1048576
UNDOLOG_PROXY_MAX_BODY_BYTES=1048576
UNDOLOG_PROXY_MAX_HEADER_BYTES=1048576

# Approval reconciliation interval and retention, in seconds.
# Defaults: 60, 86400
UNDOLOG_PROXY_APPROVAL_RECONCILE_INTERVAL_SECS=60
UNDOLOG_PROXY_APPROVAL_RETENTION_SECS=86400

# Per API key rate limit: requests per second and token bucket size.
# Both settings are required together, and 0 disables the limiter.
# Defaults: 0, 0
UNDOLOG_PROXY_RATE_LIMIT_RPS=0
UNDOLOG_PROXY_RATE_LIMIT_BURST=0

# Engine backpressure: RPCs in flight, queue depth, and queue wait in
# milliseconds. Queue depth and wait must be set together, the queue
# needs the RPC gate, and 0 disables every mechanism. Defaults: 0, 0, 0
UNDOLOG_PROXY_MAX_ENGINE_RPCS=0
UNDOLOG_PROXY_ENGINE_QUEUE_MAX=0
UNDOLOG_PROXY_ENGINE_QUEUE_WAIT_MS=0

# Circuit breaker: consecutive transport failures that open it, and how
# long it stays open in seconds. Both settings are required together,
# and 0 disables the breaker. Defaults: 0, 0
UNDOLOG_PROXY_ENGINE_BREAKER_THRESHOLD=0
UNDOLOG_PROXY_ENGINE_BREAKER_RESET_SECS=0

# Comma separated interceptor plugin names, applied in order.
# Default: empty (no plugins)
UNDOLOG_PROXY_PLUGINS=

# ─────────────────────────────────────────────────────────────────────────────
# EXAMPLE / DEMO SCRIPTS
# ─────────────────────────────────────────────────────────────────────────────

# Proxy URL for SDK client and demo scripts
UNDOLOG_PROXY_URL=http://localhost:8080

# Organisation identifier used by all demo scripts
UNDOLOG_ORG_ID=org_demo

# API key (must match a key in UNDOLOG_PROXY_API_KEYS)
UNDOLOG_API_KEY=dev-key

# Second org API key for multi-tenant demos
UNDOLOG_API_KEY_2=dev-key-2

# LLM provider (required for agent_stateful.py and run_against_stack.py)
# Compatible providers: https://api.groq.com/openai/v1, https://api.together.xyz/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Approval interrupt mode for agent_stateful.py
# cli  : prompt in the terminal for approve/reject
# auto : auto-approve after a short delay
INTERRUPT_MODE=cli

# ─────────────────────────────────────────────────────────────────────────────
# MOCK TOOL SERVER
# ─────────────────────────────────────────────────────────────────────────────

# Address and port for the stateful mock-tool-server (infra/mock-tool-server/)
MOCK_TOOL_SERVER_ADDR=0.0.0.0
MOCK_TOOL_SERVER_PORT=9091