# ═══════════════════════════════════════════════════════════════════════════════
# UndoLog Configuration Template (.env.example)
#
# Copy this file to .env and configure for your environment:
#   cp .env.example .env
#   # Edit .env with your actual values
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string for production/staging databases
# Used by: SessionStore, EffectStore, ApprovalStore
# Format: postgresql://[user[:password]@][host][:port][/database][?params]
#
# Local development (matches docker-compose defaults):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/undolog

# Test database URL (for running integration tests)
# Must be different from DATABASE_URL to avoid data corruption during testing
# Leave empty or unset if running without database integration tests
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/undolog_test

# ─────────────────────────────────────────────────────────────────────────────
# REDIS CONFIGURATION (Optional)
# ─────────────────────────────────────────────────────────────────────────────

# Redis connection string for compensation retry state and caching
# Used by: SagaOrchestrator (idempotency key deduplication)
# Format: redis://[user[:password]@][host][:port][/db][?params]
#
# Leave empty if using in-memory state (development only)
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Log level for UndoLog system
# Valid values: trace, debug, info, warn, error
UNDOLOG_LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────────
# ENGINE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Default timeout (seconds) for tool execution before marking as failed
UNDOLOG_TOOL_TIMEOUT_SECS=300

# Maximum number of concurrent effect executions per organization
UNDOLOG_MAX_CONCURRENT_EFFECTS=100

# gRPC listen address
UNDOLOG_ENGINE_GRPC_ADDR=0.0.0.0:50051

# Health check HTTP listen address
UNDOLOG_ENGINE_HEALTH_ADDR=0.0.0.0:9090

# How often (seconds) to refresh the tool registry from the database
UNDOLOG_REGISTRY_REFRESH_SECS=60

# Advisory lock retry settings
UNDOLOG_LOCK_MAX_ATTEMPTS=3
UNDOLOG_LOCK_RETRY_MS=100

# ─────────────────────────────────────────────────────────────────────────────
# PROXY CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# HTTP listen address
UNDOLOG_PROXY_LISTEN_ADDR=:8080

# gRPC address of the Rust engine
UNDOLOG_PROXY_ENGINE_GRPC_ADDR=localhost:50051

# API keys for authentication (format: key1=org_id1,key2=org_id2)
UNDOLOG_PROXY_API_KEYS=dev-key=org_dev

# HTTP timeouts (seconds)
UNDOLOG_PROXY_READ_TIMEOUT_SECS=15
UNDOLOG_PROXY_WRITE_TIMEOUT_SECS=15
UNDOLOG_PROXY_SHUTDOWN_TIMEOUT_SECS=30
UNDOLOG_PROXY_REQUEST_TIMEOUT_SECS=30

# Dashboard SSE event buffer size
UNDOLOG_PROXY_DASHBOARD_EVENT_CHAN_SIZE=128

# ─────────────────────────────────────────────────────────────────────────────
# COMPENSATION CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Base retry delay (milliseconds) for compensation HTTP requests
# Uses exponential backoff: delay * (2 ^ attempt_count)
UNDOLOG_COMPENSATION_RETRY_DELAY_MS=500

# Maximum number of retry attempts for compensation requests
UNDOLOG_COMPENSATION_MAX_RETRIES=5

# HTTP request timeout (seconds) for compensation endpoint calls
UNDOLOG_COMPENSATION_REQUEST_TIMEOUT_SECS=30

# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────────

# Environment name (used in logging and metrics)
# Valid values: development, staging, production
UNDOLOG_ENV=development

# Service name (for distributed tracing and observability)
UNDOLOG_SERVICE_NAME=undolog-engine

# ─────────────────────────────────────────────────────────────────────────────
# EXAMPLE DEMO CONFIGURATION (examples/langchain-support-agent/)
# ─────────────────────────────────────────────────────────────────────────────

# Proxy URL for demo scripts (approval_demo, compensation_demo, replay_demo)
UNDOLOG_PROXY_URL=http://localhost:8080

# Organisation identifier used by all demo scripts
UNDOLOG_ORG_ID=org_demo

# API key matching UNDOLOG_PROXY_API_KEYS in the proxy config
UNDOLOG_API_KEY=dev-key

# Second org API key for multi-tenant demos
UNDOLOG_API_KEY_2=dev-key-2

# LLM provider settings (required for run_against_stack.py and agent_stateful.py)
# Set to your OpenAI key, or switch to a compatible provider via OPENAI_BASE_URL:
#   https://api.groq.com/openai/v1
#   https://api.together.xyz/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Approval interrupt mode for agent_stateful.py
# cli     : prompt in the terminal for approve/reject
# auto    : auto-approve after a short delay
INTERRUPT_MODE=cli

# Mock tool server settings (infra/mock-tool-server/)
MOCK_TOOL_SERVER_ADDR=0.0.0.0
MOCK_TOOL_SERVER_PORT=9091