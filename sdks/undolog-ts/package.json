{
  "name": "@undobase/undolog-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the UndoLog effect-tracking and exactly-once execution system",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "tsc --noEmit -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "undolog",
    "exactly-once",
    "effect-tracking",
    "llm",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/UndoBase/UndoLog.git"
  },
  "homepage": "https://github.com/UndoBase/UndoLog",
  "bugs": {
    "url": "https://github.com/UndoBase/UndoLog/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0"
  }
}
