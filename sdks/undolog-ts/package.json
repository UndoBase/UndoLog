{
  "name": "@undolog/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for the UndoLog effect-tracking and exactly-once execution system",
  "license": "Apache-2.0",
  "type": "module",
  "author": "UndoBase <https://github.com/UndoBase>",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vercel-ai-sdk": {
      "import": {
        "types": "./dist/integrations/vercel-ai-sdk.d.ts",
        "default": "./dist/integrations/vercel-ai-sdk.js"
      },
      "require": {
        "types": "./dist/integrations/vercel-ai-sdk.d.cts",
        "default": "./dist/integrations/vercel-ai-sdk.cjs"
      }
    },
    "./langchain": {
      "import": {
        "types": "./dist/integrations/langchain.d.ts",
        "default": "./dist/integrations/langchain.js"
      },
      "require": {
        "types": "./dist/integrations/langchain.d.cts",
        "default": "./dist/integrations/langchain.cjs"
      }
    },
    "./openai": {
      "import": {
        "types": "./dist/integrations/openai.d.ts",
        "default": "./dist/integrations/openai.js"
      },
      "require": {
        "types": "./dist/integrations/openai.d.cts",
        "default": "./dist/integrations/openai.cjs"
      }
    },
    "./mastra": {
      "import": {
        "types": "./dist/integrations/mastra.d.ts",
        "default": "./dist/integrations/mastra.js"
      },
      "require": {
        "types": "./dist/integrations/mastra.d.cts",
        "default": "./dist/integrations/mastra.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp/index.d.ts",
        "default": "./dist/mcp/index.js"
      },
      "require": {
        "types": "./dist/mcp/index.d.cts",
        "default": "./dist/mcp/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/integrations/live-stack.test.ts'",
    "test:integration": "vitest run tests/integrations/live-stack.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "undolog",
    "exactly-once",
    "effect-tracking",
    "llm",
    "mcp",
    "typescript",
    "sdk",
    "tool-use",
    "ai-agents",
    "durable-execution"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/UndoBase/UndoLog.git",
    "directory": "sdks/undolog-ts"
  },
  "homepage": "https://github.com/UndoBase/UndoLog",
  "bugs": {
    "url": "https://github.com/UndoBase/UndoLog/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "ai": "^4.0.0",
    "mastra": "^0.3.0",
    "openai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "mastra": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@langchain/core": "^0.3.80",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.0.0",
    "msw": "^2.7.0",
    "tsup": "^8.4.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "langsmith": "0.6.0",
    "uuid": "11.1.1",
    "@hono/node-server": "2.0.10",
    "esbuild": "0.28.1"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0"
  }
}
